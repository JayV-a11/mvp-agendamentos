{
  "name": "frontend",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:run": "ng test --watch=false",
    "test:coverage": "ng test --watch=false --coverage",
    "test:print": "ng test --watch=false --reporters=verbose",
    "format": "prettier --write src e2e playwright.config.ts proxy.conf.json angular.json package.json .prettierrc.json",
    "format:check": "prettier --check src e2e playwright.config.ts proxy.conf.json angular.json package.json .prettierrc.json"
  },
  "private": true,
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0"
  },
  "packageManager": "npm@11.20.0",
  "dependencies": {
    "@angular/common": "22.2.3",
    "@angular/compiler": "22.2.3",
    "@angular/core": "22.2.3",
    "@angular/forms": "22.2.3",
    "@angular/platform-browser": "22.2.3",
    "@angular/router": "22.2.3",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "22.2.3",
    "@angular/cli": "22.2.3",
    "@angular/compiler-cli": "22.2.3",
    "@playwright/test": "1.64.1",
    "@vitest/coverage-v8": "5.0.5",
    "jsdom": "^30.0.0",
    "prettier": "3.9.10",
    "typescript": "~6.0.2",
    "vitest": "5.0.5"
  }
}
