# Lista JSON de origens do frontend. Não usar coringa ou barra final.
CORS_ORIGINS=["http://localhost:4200"]

# Preencher somente no .env local com a conexão do projeto Supabase.
# Formato: postgresql+psycopg://USUARIO:SENHA_CODIFICADA@HOST:5432/postgres
# Vazio mantém o banco sem configuração; /health continua verificando apenas HTTP.
DATABASE_URL=

# Gerar localmente: python -m app.core.bootstrap segredo
JWT_SECRET=
ENVIRONMENT=development
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
BUSINESS_TIMEZONE=America/Sao_Paulo

# Fotos: origem HTTPS do projeto e chave privilegiada SOMENTE no backend.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
STORAGE_BUCKET=fotos-servicos
